{
  "name": "chisel-coaching-management",
  "version": "1.0.8",
  "description": "Chisel Coaching Classes — desktop fee, payment, receipt and expense management application",
  "author": "Chisel Coaching Classes",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://github.com/iodex99/Chisel-Coaching-Management-App",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pack": "electron-vite build && electron-builder --win --dir",
    "dist": "electron-vite build && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "electron-log": "^5.2.4",
