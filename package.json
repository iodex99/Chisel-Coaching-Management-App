    "qrcode": "^1.5.4",
    "semver": "^7.6.3",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tanstack/react-query": "^5.62.7",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/semver": "^7.5.8",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
